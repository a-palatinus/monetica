<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <xs:element name="galerija">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="djelo" type="TipDjelo"
                            minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
        <xs:unique name="jedinstvenId">
            <xs:selector xpath="djelo"/>
            <xs:field xpath="@id"/>
        </xs:unique>
    </xs:element>
    <xs:complexType name="TipDjelo">
        <xs:all>
            <xs:element name="naslov"     type="TipNeprazniTekst"/>
            <xs:element name="autor"      type="TipNeprazniTekst"/>
            <xs:element name="tehnika"    type="TipNeprazniTekst"/>
            <xs:element name="godina"     type="TipGodina"/>
            <xs:element name="dimenzije"  type="xs:string"/>
            <xs:element name="kategorija" type="TipKategorija"/>
            <xs:element name="slika"      type="xs:string"/>
            <xs:element name="opis"       type="xs:string"/>
        </xs:all>
        <xs:attribute name="id" type="TipPozitivniCijeli" use="required"/>
    </xs:complexType>

    <xs:simpleType name="TipPozitivniCijeli">
        <xs:restriction base="xs:positiveInteger"/>
    </xs:simpleType>

    <xs:simpleType name="TipNeprazniTekst">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TipGodina">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1800"/>
            <xs:maxInclusive value="2100"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="TipKategorija">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Slikarstvo"/>
            <xs:enumeration value="Fotografija"/>
            <xs:enumeration value="Crtež"/>
            <xs:enumeration value="Ostalo"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
